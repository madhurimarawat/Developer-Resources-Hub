
# Site information
title: "Developer Resources Hub"
tagline: "Your collection of developer resources"
description: >-
  A comprehensive collection of valuable resources for developers,
  covering programming, job preparation, frontend, backend,
  AI, machine learning, IoT, databases, and much more.

url: "https://madhurimarawat.github.io"
baseurl: "/Developer-Resources-Hub"

# Midnight theme
remote_theme: pages-themes/midnight@v0.2.0

# Repository
repository: madhurimarawat/Developer-Resources-Hub

# Language
lang: en-US

# SEO
plugins:
  - jekyll-remote-theme
  - jekyll-seo-tag

author:
  name: "Madhuri Rawat"

# Markdown
markdown: kramdown
highlighter: rouge

kramdown:
  input: GFM
  syntax_highlighter: rouge

# Theme settings
show_downloads: true

# Build settings
permalink: pretty
timezone: Asia/Kolkata

# Exclude files
exclude:
  - Gemfile
  - Gemfile.lock
  - node_modules
  - vendor
  - .github
  - .gitignore
  - LICENSE
  - CONTRIBUTING.md
