
# ==========================================
# Developer Resources Hub
# Jekyll + Midnight Theme
# ==========================================

# Site information
title: "Developer Resources Hub"

description: >-
  A comprehensive collection of valuable resources for developers,
  covering programming, job preparation, frontend, backend,
  AI, machine learning, IoT, databases, and much more.

url: "https://madhurimarawat.github.io"
baseurl: "/Developer-Resources-Hub"

# ==========================================
# Theme
# ==========================================

remote_theme: pages-themes/midnight@v0.2.0

# Repository information
repository: madhurimarawat/Developer-Resources-Hub

# Language
lang: en-US

# ==========================================
# SEO
# ==========================================

plugins:
  - jekyll-remote-theme
  - jekyll-seo-tag

author:
  name: "Madhuri Rawat"

twitter:
  card: summary

# ==========================================
# Markdown
# ==========================================

markdown: kramdown
highlighter: rouge

kramdown:
  input: GFM
  syntax_highlighter: rouge

# ==========================================
# Build settings
# ==========================================

permalink: pretty
timezone: Asia/Kolkata

# ==========================================
# GitHub repository links
# ==========================================

show_downloads: true

github:
  repository_url: "https://github.com/madhurimarawat/Developer-Resources-Hub"

# ==========================================
# Excluded files
# ==========================================

exclude:
  - Gemfile
  - Gemfile.lock
  - node_modules
  - vendor
  - .github
  - .gitignore
  - LICENSE
  - CONTRIBUTING.md
